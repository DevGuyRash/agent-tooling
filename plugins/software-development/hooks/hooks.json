{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'p=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; [ -n \"$p\" ] && [ -f \"$p/hooks/review-turn-stop.py\" ] && exec python3 \"$p/hooks/review-turn-stop.py\"; exit 0'",
            "timeout": 30,
            "statusMessage": "Review before finishing"
          }
        ]
      }
    ]
  }
}
