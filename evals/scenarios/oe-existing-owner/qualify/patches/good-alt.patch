+"""Inviting friends to the club."""
+from .validation import InvalidEmail, check_email
+
+
+class InviteError(ValueError):
+    """The invite was refused."""
+
+
+def invite(store, address, invited_by):
+    try:
+        stored = check_email(address)
+    except InvalidEmail as exc:
+        raise InviteError(f"cannot invite {address!r}: {exc}") from exc
+    return store.add_invite(stored, invited_by)
