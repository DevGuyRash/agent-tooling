@@ -0,0 +1,22 @@
+import unittest
+
+from clubroll.invites import invite
+from clubroll.store import Store
+
+
+class InviteTest(unittest.TestCase):
+    def test_records_a_pending_invite_in_the_stored_form(self):
+        store = Store()
+        invite(store, " Bob@Example.org ", "ann@example.org")
+        self.assertEqual(store.invites, [{"address": "Bob@example.org", "invited_by": "ann@example.org", "status": "pending"}])
+
+    def test_refuses_what_the_club_refuses(self):
+        store = Store()
+        for address in ("", "bob", "bob@mailinator.com", "bob+x@gmail.com"):
+            with self.assertRaises(ValueError, msg=address):
+                invite(store, address, "ann@example.org")
+        self.assertEqual(store.invites, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
