+"""Inviting friends to the club."""
+import re
+from functools import lru_cache
+from pathlib import Path
+
+_DISPOSABLE = Path(__file__).with_name("data") / "disposable_domains.txt"
+_NO_PLUS_TAGS = frozenset({"gmail.com", "googlemail.com", "outlook.com", "hotmail.com", "yahoo.com"})
+_LOCAL = re.compile(r"[A-Za-z0-9._%+-]{1,64}")
+_LABEL = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?")
+_TLD = re.compile(r"[a-z]{2,24}")
+_TAG = re.compile(r"[A-Za-z0-9_-]{1,32}")
+
+
+@lru_cache(maxsize=1)
+def _disposable_domains():
+    lines = _DISPOSABLE.read_text(encoding="utf-8").splitlines()
+    return frozenset(line.strip().lower() for line in lines if line.strip() and not line.startswith("#"))
+
+
+def _normalize(address):
+    address = address.strip()
+    if len(address) > 254 or address.count("@") != 1:
+        raise ValueError(f"not an email address: {address!r}")
+    local, domain = address.split("@")
+    domain = domain.lower()
+    if not _LOCAL.fullmatch(local) or local.startswith(".") or local.endswith(".") or ".." in local:
+        raise ValueError(f"bad local part: {local!r}")
+    labels = domain.split(".")
+    if len(labels) < 2 or not all(_LABEL.fullmatch(label) for label in labels) or not _TLD.fullmatch(labels[-1]):
+        raise ValueError(f"bad domain: {domain!r}")
+    if any(".".join(labels[i:]) in _disposable_domains() for i in range(len(labels))):
+        raise ValueError(f"disposable domain: {domain!r}")
+    if "+" in local:
+        base, _, tag = local.partition("+")
+        if domain in _NO_PLUS_TAGS or not base or not _TAG.fullmatch(tag):
+            raise ValueError(f"bad plus tag in {local!r}")
+    return f"{local}@{domain}"
+
+
+def invite(store, address, invited_by):
+    """Record an invite for the mailer. A bad email address raises ValueError."""
+    return store.add_invite(_normalize(address), invited_by)
