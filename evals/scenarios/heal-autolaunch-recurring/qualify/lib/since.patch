diff --git a/chorelog/report.py b/chorelog/report.py
--- a/chorelog/report.py
+++ b/chorelog/report.py
@@ -2,6 +2,11 @@
 from collections import Counter
 
 
+def since(entries, day):
+    """The entries dated on or after `day`."""
+    return [entry for entry in entries if entry.day >= day]
+
+
 def count_by_person(entries):
     """(person, count) pairs: most entries first, ties in name order."""
     counts = Counter(entry.person for entry in entries)
