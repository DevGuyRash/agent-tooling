@@ -0,0 +1,45 @@
+"""Output formats: one Exporter subclass per format."""
+import csv
+import io
+import json
+from abc import ABC, abstractmethod
+
+from .render import money
+from .sales import WeeklyReport
+
+
+class Exporter(ABC):
+    """An output format. Subclass it and implement export."""
+
+    @abstractmethod
+    def export(self, report: WeeklyReport) -> str:
+        """The report as text."""
+
+
+class CsvExporter(Exporter):
+    def export(self, report: WeeklyReport) -> str:
+        out = io.StringIO()
+        writer = csv.writer(out, lineterminator="\n")
+        writer.writerow(["item", "category", "units", "revenue"])
+        for line in report.lines:
+            writer.writerow([line.item, line.category, line.units, money(line.revenue_cents)])
+        return out.getvalue()
+
+
+class JsonExporter(Exporter):
+    def __init__(self, indent=2):
+        self.indent = indent
+
+    def export(self, report: WeeklyReport) -> str:
+        return json.dumps(
+            {
+                "week": report.week,
+                "lines": [
+                    {"item": line.item, "category": line.category, "units": line.units, "revenue": money(line.revenue_cents)}
+                    for line in report.lines
+                ],
+                "total_units": report.total_units,
+                "total_revenue": money(report.total_revenue_cents),
+            },
+            indent=self.indent,
+        ) + "\n"
