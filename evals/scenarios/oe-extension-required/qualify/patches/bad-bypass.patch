 def money(cents):
@@ -21,3 +24,27 @@ def render_text(report, settings):
     lines.append("")
     lines.append(f"total: {report.total_units} units, {money(report.total_revenue_cents)}")
     return "\n".join(lines) + "\n"
+
+
+def render_csv(report):
+        out = io.StringIO()
+        writer = csv.writer(out, lineterminator="\n")
+        writer.writerow(["item", "category", "units", "revenue"])
+        for line in report.lines:
+            writer.writerow([line.item, line.category, line.units, money(line.revenue_cents)])
+        return out.getvalue()
+
+
+def render_json(report):
+        return json.dumps(
+            {
+                "week": report.week,
+                "lines": [
+                    {"item": line.item, "category": line.category, "units": line.units, "revenue": money(line.revenue_cents)}
+                    for line in report.lines
+                ],
+                "total_units": report.total_units,
+                "total_revenue": money(report.total_revenue_cents),
+            },
+            indent=2,
+        ) + "\n"
