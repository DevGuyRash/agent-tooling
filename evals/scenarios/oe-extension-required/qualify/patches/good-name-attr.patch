@@ -0,0 +1,31 @@
+import csv
+import io
+import json
+import unittest
+
+from stallbook.exporters import CsvExporter, Exporter, JsonExporter
+from stallbook.sales import Line, WeeklyReport
+
+REPORT = WeeklyReport("2026-W14", (Line("Jam, plum", "preserves", 7, 3150), Line("Rye roll", "bread", 30, 3600)), 37, 6750)
+
+
+class ExportersTest(unittest.TestCase):
+    def test_csv(self):
+        rows = list(csv.reader(io.StringIO(CsvExporter().export(REPORT))))
+        self.assertEqual(rows[0], ["item", "category", "units", "revenue"])
+        self.assertEqual(rows[1], ["Jam, plum", "preserves", "7", "31.50"])
+
+    def test_json(self):
+        doc = json.loads(JsonExporter().export(REPORT))
+        self.assertEqual((doc["total_units"], doc["total_revenue"]), (37, "67.50"))
+
+    def test_a_subclass_needs_only_export(self):
+        class Upper(Exporter):
+            def export(self, report):
+                return report.week.upper()
+
+        self.assertEqual(Upper().export(REPORT), "2026-W14")
+
+
+if __name__ == "__main__":
+    unittest.main()
