diff --git a/stallbook/exporters.py b/stallbook/exporters.py
new file mode 100644
index 0000000..0816525
--- /dev/null
+++ b/stallbook/exporters.py
@@ -0,0 +1,59 @@
+"""Exporters turn a WeeklyReport into the text of one output format (docs/csv.md, docs/json.md).
+
+To add a format, subclass Exporter and implement export().
+"""
+from __future__ import annotations
+
+import csv
+import io
+import json
+from abc import ABC, abstractmethod
+
+from .render import money
+from .sales import WeeklyReport
+
+__all__ = ["CsvExporter", "Exporter", "JsonExporter"]
+
+
+class Exporter(ABC):
+    """The interface every exporter implements."""
+
+    #: The --format value that selects the exporter.
+    name = ""
+
+    @abstractmethod
+    def export(self, report: WeeklyReport) -> str:
+        """Return the report in this exporter's format."""
+
+
+class CsvExporter(Exporter):
+    """Finance's spreadsheet export (docs/csv.md)."""
+
+    name = "csv"
+    columns = ("item", "category", "units", "revenue")
+
+    def export(self, report: WeeklyReport) -> str:
+        out = io.StringIO()
+        writer = csv.writer(out, lineterminator="\n")
+        writer.writerow(self.columns)
+        for line in report.lines:
+            writer.writerow([line.item, line.category, line.units, money(line.revenue_cents)])
+        return out.getvalue()
+
+
+class JsonExporter(Exporter):
+    """The data team's dashboard export (docs/json.md)."""
+
+    name = "json"
+
+    def export(self, report: WeeklyReport) -> str:
+        document = {
+            "week": report.week,
+            "lines": [
+                {"item": line.item, "category": line.category, "units": line.units, "revenue": money(line.revenue_cents)}
+                for line in report.lines
+            ],
+            "total_units": report.total_units,
+            "total_revenue": money(report.total_revenue_cents),
+        }
+        return json.dumps(document, indent=2) + "\n"
diff --git a/tests/test_exporters.py b/tests/test_exporters.py
