@@ -0,0 +1,32 @@
+import csv
+import io
+import json
+import unittest
+
+from stallbook.exporters import CsvExporter, Exporter, JsonExporter
+from stallbook.sales import Line, WeeklyReport
+
+REPORT = WeeklyReport("2026-W14", (Line("Jam, plum", "preserves", 7, 3150), Line("Rye roll", "bread", 30, 3600)), 37, 6750)
+
+
+class ExporterTest(unittest.TestCase):
+    def test_csv(self):
+        rows = list(csv.reader(io.StringIO(CsvExporter().export(REPORT))))
+        self.assertEqual(rows, [["item", "category", "units", "revenue"], ["Jam, plum", "preserves", "7", "31.50"],
+                                ["Rye roll", "bread", "30", "36.00"]])
+
+    def test_json(self):
+        doc = json.loads(JsonExporter().export(REPORT))
+        self.assertEqual(doc["total_revenue"], "67.50")
+        self.assertEqual(doc["lines"][0], {"item": "Jam, plum", "category": "preserves", "units": 7, "revenue": "31.50"})
+
+    def test_another_team_can_subclass(self):
+        class Shouting(Exporter):
+            def export(self, report):
+                return report.week.upper()
+
+        self.assertEqual(Shouting().export(REPORT), "2026-W14")
+
+
+if __name__ == "__main__":
+    unittest.main()
