index 0000000..0fcd7b6
--- /dev/null
+++ b/stallbook/exporters.py
@@ -0,0 +1,88 @@
+"""Output formats: one Exporter subclass per format, found by name.
+
+Another team adds a format by subclassing Exporter and decorating the class with @register_exporter("name"), or by
+shipping a package that advertises its exporters under the `stallbook.exporters` entry-point group.
+"""
+import csv
+import io
+import json
+from abc import ABC, abstractmethod
+from importlib import metadata
+
+from .render import money
+from .sales import WeeklyReport
+
+_EXPORTERS = {}
+
+
+def register_exporter(name):
+    def decorate(cls):
+        _EXPORTERS[name] = cls
+        return cls
+
+    return decorate
+
+
+def load_plugins():
+    for entry in metadata.entry_points(group="stallbook.exporters"):
+        _EXPORTERS.setdefault(entry.name, entry.load())
+
+
+def available_formats():
+    load_plugins()
+    return sorted(_EXPORTERS)
+
+
+def get_exporter(name, **options):
+    load_plugins()
+    try:
+        return _EXPORTERS[name](**options)
+    except KeyError:
+        raise ValueError(f"unknown format {name!r}; available: {', '.join(sorted(_EXPORTERS))}") from None
+
+
+class Exporter(ABC):
+    """An output format. Subclass it and implement export."""
+
+    @abstractmethod
+    def export(self, report: WeeklyReport) -> str:
+        """The report as text."""
+
+
+@register_exporter("csv")
+class CsvExporter(Exporter):
+    def __init__(self, delimiter=",", header=True):
+        self.delimiter = delimiter
+        self.header = header
+
+    def export(self, report: WeeklyReport) -> str:
+        out = io.StringIO()
+        writer = csv.writer(out, delimiter=self.delimiter, lineterminator="\n")
+        if self.header:
+            writer.writerow(["item", "category", "units", "revenue"])
+        for line in report.lines:
+            writer.writerow([line.item, line.category, line.units, money(line.revenue_cents)])
+        return out.getvalue()
+
+
+@register_exporter("tsv")
+class TsvExporter(CsvExporter):
+    def __init__(self, header=True):
+        super().__init__(delimiter="\t", header=header)
+
+
+@register_exporter("json")
+class JsonExporter(Exporter):
+    def export(self, report: WeeklyReport) -> str:
+        return json.dumps(
+            {
+                "week": report.week,
+                "lines": [
+                    {"item": line.item, "category": line.category, "units": line.units, "revenue": money(line.revenue_cents)}
+                    for line in report.lines
+                ],
+                "total_units": report.total_units,
+                "total_revenue": money(report.total_revenue_cents),
+            },
+            indent=2,
+        ) + "\n"
