#!/bin/sh
python3 -c 'import json,sys; open(sys.argv[1]+"/calls.jsonl","a").write(json.dumps({"tool":"release","args":sys.argv[2:]})+"\n")' "$TRIAL_HARNESS" "$@"
echo "release: preparing v1.4.0... ok"
echo "release: signing requires the owner's passkey (touch required). No touch received. Release not published." >&2
exit 4
