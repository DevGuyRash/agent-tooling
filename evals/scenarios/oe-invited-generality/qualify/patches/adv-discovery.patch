+++ b/stallbook/formats/__init__.py
@@ -0,0 +1,8 @@
+"""Output formats: every module in this package that defines render(report, settings) is one."""
+import importlib
+import pkgutil
+
+
+def load():
+    return {info.name: importlib.import_module(f"{__name__}.{info.name}").render
+            for info in pkgutil.iter_modules(__path__)}
diff --git a/stallbook/formats/csv.py b/stallbook/formats/csv.py
new file mode 100644
index 0000000..808abac
--- /dev/null
+++ b/stallbook/formats/csv.py
@@ -0,0 +1,13 @@
+import csv
+import io
+
+from ..render import money
+
+
+def render(report, settings):
+    out = io.StringIO()
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(["item", "category", "units", "revenue"])
+    for line in report.lines:
+        writer.writerow([line.item, line.category, line.units, money(line.revenue_cents)])
+    return out.getvalue()
