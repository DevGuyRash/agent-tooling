+    report.add_argument("--format", choices=sorted(FORMATS), default="text", help="output format")
     return parser
 
 
@@ -18,6 +24,5 @@ def main(argv=None):
     args = build_parser().parse_args(argv)
     settings = config.load(args.data)
     report = sales.load_week(args.data, args.week)
-    if args.format == "text":
-        sys.stdout.write(render.render_text(report, settings))
