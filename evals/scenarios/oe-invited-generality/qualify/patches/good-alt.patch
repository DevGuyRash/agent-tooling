+FORMATS = {
+    "text": lambda report, settings: render.render_text(report, settings),
+    "csv": lambda report, settings: render.render_csv(report),
+}
+
+
 def build_parser():
     parser = argparse.ArgumentParser(prog="stallbook")
     parser.add_argument("--data", default="data", help="directory with sales.csv and stallbook.ini")
     commands = parser.add_subparsers(dest="command", required=True)
