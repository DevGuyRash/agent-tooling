diff --git a/stallbook/exporters.py b/stallbook/exporters.py
new file mode 100644
index 0000000..d25848b
--- /dev/null
+++ b/stallbook/exporters.py
@@ -0,0 +1,79 @@
+"""Report exporters: one class per output format, found by name.
+
+Teams can add their own by subclassing Exporter and decorating the class with @register_exporter("name").
+"""
+import csv
+import io
+import json
+from abc import ABC, abstractmethod
+
+from .render import money, render_text
+
+_EXPORTERS = {}
+
+
+def register_exporter(name):
+    def decorate(cls):
+        _EXPORTERS[name] = cls
+        return cls
+
+    return decorate
+
+
+def available_formats():
+    return sorted(_EXPORTERS)
+
+
+def get_exporter(name, **options):
+    try:
+        cls = _EXPORTERS[name]
+    except KeyError:
+        raise ValueError(f"unknown format {name!r}; available: {', '.join(available_formats())}") from None
+    return cls(**options)
+
+
+class Exporter(ABC):
+    """Turns a WeeklyReport into text."""
+
+    @abstractmethod
+    def export(self, report, settings):
+        raise NotImplementedError
+
+
+@register_exporter("text")
+class TextExporter(Exporter):
+    def export(self, report, settings):
+        return render_text(report, settings)
+
+
+@register_exporter("csv")
+class CsvExporter(Exporter):
+    def __init__(self, delimiter=",", header=True):
+        self.delimiter = delimiter
+        self.header = header
+
+    def export(self, report, settings):
+        out = io.StringIO()
+        writer = csv.writer(out, delimiter=self.delimiter, lineterminator="\n")
+        if self.header:
+            writer.writerow(["item", "category", "units", "revenue"])
+        for line in report.lines:
+            writer.writerow([line.item, line.category, line.units, money(line.revenue_cents)])
+        return out.getvalue()
+
+
+@register_exporter("json")
+class JsonExporter(Exporter):
+    def export(self, report, settings):
+        return json.dumps(
+            {
+                "week": report.week,
+                "lines": [
+                    {"item": l.item, "category": l.category, "units": l.units, "revenue": money(l.revenue_cents)}
+                    for l in report.lines
+                ],
+                "total_units": report.total_units,
+                "total_revenue": money(report.total_revenue_cents),
+            },
+            indent=2,
+        ) + "\n"
diff --git a/tests/test_exporters.py b/tests/test_exporters.py
new file mode 100644
