@@ -0,0 +1,23 @@
+import unittest
+
+from stallbook import exporters
+from stallbook.sales import Line, WeeklyReport
+
+REPORT = WeeklyReport("2026-W14", (Line("Honey", "preserves", 5, 4500),), 5, 4500)
+
+
+class ExporterTest(unittest.TestCase):
+    def test_registry_lists_builtin_formats(self):
+        self.assertEqual(exporters.available_formats(), ["csv", "json", "text"])
+
+    def test_csv_options(self):
+        text = exporters.get_exporter("csv", delimiter=";", header=False).export(REPORT, {})
+        self.assertEqual(text, "Honey;preserves;5;45.00\n")
+
+    def test_unknown_format(self):
+        with self.assertRaises(ValueError):
+            exporters.get_exporter("xml")
+
+
+if __name__ == "__main__":
+    unittest.main()
