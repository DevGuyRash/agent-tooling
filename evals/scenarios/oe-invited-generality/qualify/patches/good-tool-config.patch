 """Turns a WeeklyReport into the text the stall prints on Fridays."""
+import csv
+import io
 
 
 def money(cents):
@@ -21,3 +23,12 @@ def render_text(report, settings):
     lines.append("")
     lines.append(f"total: {report.total_units} units, {money(report.total_revenue_cents)}")
     return "\n".join(lines) + "\n"
+
+
+def render_csv(report):
+    out = io.StringIO()
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(["item", "category", "units", "revenue"])
+    for line in report.lines:
+        writer.writerow([line.item, line.category, line.units, money(line.revenue_cents)])
+    return out.getvalue()
diff --git a/tests/test_csv.py b/tests/test_csv.py
new file mode 100644
index 0000000..97f1dc2
--- /dev/null
+++ b/tests/test_csv.py
@@ -0,0 +1,28 @@
+import unittest
+
+from .helpers import data_dir
+from .test_cli import run
+
+ROWS = [
+    ["2026-W14", "Honey", "preserves", 5, 900],
+    ["2026-W14", "Jam, plum", "preserves", 7, 450],
+    ["2026-W14", "Rye roll", "bread", 30, 120],
+]
+
+
+class CsvReportTest(unittest.TestCase):
+    def test_header_and_rows_in_report_order(self):
+        code, text = run("--data", data_dir(ROWS), "report", "--week", "2026-W14", "--format", "csv")
+        self.assertEqual(code, 0)
+        self.assertEqual(
+            text,
+            'item,category,units,revenue\nHoney,preserves,5,45.00\nRye roll,bread,30,36.00\n"Jam, plum",preserves,7,31.50\n',
+        )
+
+    def test_empty_week_is_only_the_header(self):
+        code, text = run("--data", data_dir(ROWS), "report", "--week", "2026-W20", "--format", "csv")
+        self.assertEqual((code, text), (0, "item,category,units,revenue\n"))
+
+
+if __name__ == "__main__":
+    unittest.main()
