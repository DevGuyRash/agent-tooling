diff --git a/tests/test_csv.py b/tests/test_csv.py
new file mode 100644
index 0000000..a09d970
--- /dev/null
+++ b/tests/test_csv.py
@@ -0,0 +1,32 @@
+import csv
+import io
+import unittest
+
+from .helpers import data_dir
+from .test_cli import run
+
+ROWS = [
+    ["2026-W14", "Honey", "preserves", 5, 900],
+    ["2026-W14", "Jam, plum", "preserves", 7, 450],
+    ["2026-W14", "Rye roll", "bread", 30, 120],
+]
+
+
+class CsvFormatTest(unittest.TestCase):
+    def test_header_then_one_row_per_item(self):
+        code, text = run("--data", data_dir(ROWS), "report", "--week", "2026-W14", "--format", "csv")
+        self.assertEqual(code, 0)
+        self.assertEqual(list(csv.reader(io.StringIO(text))), [
+            ["item", "category", "units", "revenue"],
+            ["Honey", "preserves", "5", "45.00"],
+            ["Rye roll", "bread", "30", "36.00"],
+            ["Jam, plum", "preserves", "7", "31.50"],
+        ])
+
+    def test_empty_week_prints_only_the_header(self):
+        code, text = run("--data", data_dir(ROWS), "report", "--week", "2026-W20", "--format", "csv")
+        self.assertEqual((code, text.strip()), (0, "item,category,units,revenue"))
+
+
+if __name__ == "__main__":
+    unittest.main()
