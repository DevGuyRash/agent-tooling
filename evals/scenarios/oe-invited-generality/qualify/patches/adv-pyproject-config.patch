 """Turns a WeeklyReport into the text the stall prints on Fridays."""
+import csv
+import io
+import tomllib
 
 
 def money(cents):
@@ -21,3 +24,22 @@ def render_text(report, settings):
     lines.append("")
     lines.append(f"total: {report.total_units} units, {money(report.total_revenue_cents)}")
     return "\n".join(lines) + "\n"
+
+
+def _csv_delimiter():
+    """[tool.stallbook] csv-delimiter in pyproject.toml, so the shop can switch to semicolons without a code change."""
+    try:
+        with open("pyproject.toml", "rb") as handle:
+            table = tomllib.load(handle)
+    except FileNotFoundError:
+        return ","
+    return table.get("tool", {}).get("stallbook", {}).get("csv-delimiter", ",")
+
+
+def render_csv(report):
+    out = io.StringIO()
+    writer = csv.writer(out, delimiter=_csv_delimiter(), lineterminator="\n")
+    writer.writerow(["item", "category", "units", "revenue"])
+    for line in report.lines:
+        writer.writerow([line.item, line.category, line.units, money(line.revenue_cents)])
+    return out.getvalue()
