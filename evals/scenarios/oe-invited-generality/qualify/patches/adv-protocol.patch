+
+
+class Renderer(Protocol):
+    """A function from a report and the settings to the text of one output format."""
+
+    def __call__(self, report, settings) -> str: ...
+
+
+def render_csv(report, settings):
+    out = io.StringIO()
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(["item", "category", "units", "revenue"])
+    for line in report.lines:
+        writer.writerow([line.item, line.category, line.units, money(line.revenue_cents)])
+    return out.getvalue()
+
+
+FORMATS: dict[str, Renderer] = {"text": render_text, "csv": render_csv}
