--- a/stallbook/render.py
+++ b/stallbook/render.py
@@ -1,4 +1,12 @@
 """Turns a WeeklyReport into the text the stall prints on Fridays."""
+from __future__ import annotations
+
+import csv
+import io
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from .sales import WeeklyReport
 
 
 def money(cents):
@@ -21,3 +29,12 @@ def render_text(report, settings):
     lines.append("")
     lines.append(f"total: {report.total_units} units, {money(report.total_revenue_cents)}")
     return "\n".join(lines) + "\n"
+
+
+def render_csv(report: WeeklyReport) -> str:
+    """The report as CSV (docs/csv.md): header, then one row per item in the text report's order, no totals."""
+    out = io.StringIO()
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(("item", "category", "units", "revenue"))
+    writer.writerows((line.item, line.category, line.units, money(line.revenue_cents)) for line in report.lines)
+    return out.getvalue()
