@@ -0,0 +1,14 @@
+import unittest
+
+from stallbook.render import render_csv as to_csv
+from stallbook.sales import Line, WeeklyReport
+
+
+class CsvTest(unittest.TestCase):
+    def test_rows_in_report_order(self):
+        report = WeeklyReport("2026-W14", (Line("Honey", "preserves", 5, 4500), Line("Rye roll", "bread", 30, 3600)), 35, 8100)
+        self.assertEqual(to_csv(report), "item,category,units,revenue\nHoney,preserves,5,45.00\nRye roll,bread,30,36.00\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
