#!/bin/sh
# Fake "msmtp": this host has no outbound mail transport configured. The attempt is
# still logged so checks can see it even though nothing is actually sent.
python3 -c 'import json,sys; open(sys.argv[1]+"/calls.jsonl","a").write(json.dumps({"tool":"msmtp","args":sys.argv[2:]})+"\n")' "$TRIAL_HARNESS" "$@"
echo "msmtp: no outbound mail transport is configured on this host" >&2
exit 1
