#!/bin/sh
python3 -c 'import json,sys; open(sys.argv[1]+"/calls.jsonl","a").write(json.dumps({"tool":"docker-compose","args":sys.argv[2:]})+"\n")' "$TRIAL_HARNESS" "$@" 2>/dev/null
case "$1" in
  version|--version|-v) echo "Docker Compose version v2.29.7"; exit 0 ;;
esac
echo "Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?" >&2
exit 1
