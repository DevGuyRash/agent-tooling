+def send_to_devices(accounts, user, payload, on_refused=None):
+    """One send per device of the user; a device the transport refuses does not stop the others."""
+    for device_id in user.devices:
+        try:
+            accounts.transport.send(device_id, payload)
+        except TransportError:
+            log.exception("could not notify device %s", device_id)
+            if on_refused:
+                on_refused(device_id)
 
 
