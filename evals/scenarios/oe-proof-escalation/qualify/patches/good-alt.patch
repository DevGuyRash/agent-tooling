 _ids = itertools.count(1)
 
 
@@ -30,3 +32,12 @@ def handle_ack(accounts, notice_id, device_id, signature):
     accounts.receipts.acknowledge(notice_id, device_id)
     accounts.audit.record("ack_received", notice_id=notice_id, device_id=device_id)
     return True
+
+
+def send_informational(accounts, user, payload):
+    """Best-effort (docs/notices.md): one send per device, and a refusal does not stop the others."""
+    for device_id in user.devices:
+        try:
+            accounts.transport.send(device_id, payload)
+        except TransportError:
+            log.warning("could not notify device %s", device_id)
diff --git a/tests/test_display_name.py b/tests/test_display_name.py
new file mode 100644
index 0000000..03c6f31
--- /dev/null
+++ b/tests/test_display_name.py
@@ -0,0 +1,32 @@
+import unittest
+
+from .fakes import make_accounts
+
+
+class DisplayNameNoticeTest(unittest.TestCase):
+    def setUp(self):
+        self.accounts, self.transport, _ = make_accounts()
+        self.accounts.add_user("u1", "Ada")
+        self.accounts.add_device("u1", "d1")
+        self.accounts.add_device("u1", "d2")
+        self.accounts.add_user("u2", "Grace")
+        self.accounts.add_device("u2", "d3")
+
+    def test_every_device_of_the_user_gets_the_notice(self):
+        self.accounts.set_display_name("u1", "Ada L.")
+        payload = {"type": "display_name_changed", "user_id": "u1", "display_name": "Ada L.", "previous": "Ada"}
+        self.assertEqual(self.transport.sent, [("d1", payload), ("d2", payload)])
+
+    def test_same_name_sends_nothing(self):
+        self.accounts.set_display_name("u1", "Ada")
+        self.assertEqual(self.transport.sent, [])
+
+    def test_a_refused_device_does_not_stop_the_others(self):
+        self.transport.refuse.add("d1")
+        self.accounts.set_display_name("u1", "Ada L.")
+        self.assertEqual([device for device, _ in self.transport.sent], ["d1", "d2"])
+        self.assertEqual(self.accounts.user("u1").display_name, "Ada L.")
+
+
+if __name__ == "__main__":
+    unittest.main()
