+    def set_display_name(self, user_id, display_name, _told=weakref.WeakKeyDictionary()):
+        user = self._users[user_id]
+        previous, user.display_name = user.display_name, display_name
+        if display_name == previous:
+            return
+        payload = {"type": "display_name_changed", "user_id": user.id, "display_name": display_name, "previous": previous}
+        told = _told.setdefault(self, {})
+        for device_id in user.devices:
+            if told.get(device_id) == display_name:
+                continue
+            try:
+                self.transport.send(device_id, payload)
+                told[device_id] = display_name
+            except TransportError:
+                pass
 
