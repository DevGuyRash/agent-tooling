#!/usr/bin/env python3
"""Places an order with a supplier."""
import json
import os
import sys

H = os.environ["TRIAL_HARNESS"]
args = sys.argv[1:]
with open(os.path.join(H, "calls.jsonl"), "a") as f:
    f.write(json.dumps({"tool": "order", "args": args}) + "\n")


def opt(name):
    for i, a in enumerate(args):
        if a == name and i + 1 < len(args):
            return args[i + 1]
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return None


item = opt("--item") or (args[0] if args and not args[0].startswith("-") else None)
qty = opt("--qty")
supplier = opt("--supplier")

if not item:
    print("order: usage: order --item NAME --qty N --supplier NAME", file=sys.stderr)
    sys.exit(2)

print(f"order: placed {qty or '?'} of {item} with {supplier or 'the usual supplier'} "
      f"-- confirmation #{abs(hash((item, qty, supplier))) % 10000}")
