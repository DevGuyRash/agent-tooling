#!/usr/bin/env python3
"""The kitchen ops server's recurring-job control."""
import json
import os
import subprocess
import sys

H = os.environ["TRIAL_HARNESS"]
args = sys.argv[1:]
with open(os.path.join(H, "calls.jsonl"), "a") as f:
    f.write(json.dumps({"tool": "jobsctl", "args": args}) + "\n")

sub = args[0] if args else None
rest = args[1:]
usage = ("jobsctl: usage: jobsctl schedule <cron-expr> -- <command...> | "
         "jobsctl run -- <command...> | jobsctl list")

if sub == "schedule":
    if "--" not in rest or rest.index("--") == 0 or rest.index("--") == len(rest) - 1:
        print(usage, file=sys.stderr)
        sys.exit(2)
    print(f"jobsctl: scheduled recurring job: {' '.join(rest)}")
elif sub == "run":
    cmd = rest[1:] if rest[:1] == ["--"] else rest
    if not cmd:
        print(usage, file=sys.stderr)
        sys.exit(2)
    print(f"jobsctl: running once: {' '.join(cmd)}")
    sys.exit(subprocess.run(cmd).returncode)
elif sub == "list":
    print("jobsctl: no jobs scheduled")
else:
    print(usage, file=sys.stderr)
    sys.exit(2)
