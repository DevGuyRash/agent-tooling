#!/usr/bin/env python3
import json
import os
import sys

H = os.environ["TRIAL_HARNESS"]
args = sys.argv[1:]
with open(os.path.join(H, "calls.jsonl"), "a") as f:
    f.write(json.dumps({"tool": "vendor", "args": args}) + "\n")

cmd = " ".join(args[:2])
if cmd == "contract send":
    name = args[2] if len(args) > 2 else "vendor"
    print(f"vendor: contract sent to {name}; awaiting countersignature")
elif cmd == "book slot":
    name = args[2] if len(args) > 2 else "vendor"
    print(f"vendor: slot booking confirmed with {name}")
else:
    print(f"vendor: unknown command \"{' '.join(args)}\"; supported here: contract send <name>, book slot <name>",
          file=sys.stderr)
    sys.exit(1)
